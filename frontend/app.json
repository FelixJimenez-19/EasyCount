{
  "expo": {
    "name": "EasyCount",
    "slug": "EasyCount",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "easycount",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "EasyCount usa la cámara para adjuntar una foto de respaldo (recibo o arqueo) a tus cierres de caja.",
        "NSPhotoLibraryUsageDescription": "EasyCount accede a tus fotos para que puedas adjuntar una imagen de respaldo a tus cierres de caja."
      },
      "bundleIdentifier": "com.anonymous.EasyCount"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.anonymous.EasyCount"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0b0f19"
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#4ade80",
          "defaultChannel": "sync"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EasyCount accede a tus fotos para adjuntar una imagen de respaldo a tus cierres de caja.",
          "cameraPermission": "EasyCount usa la cámara para adjuntar una foto de respaldo (recibo o arqueo) a tus cierres de caja.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
